---
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: 'inicio' | 'productos' | 'servicios' | 'quienes-somos' | 'contacto';
}

const {
  title = 'ClimaCold | Alquiler de Cuartos Fríos Industriales y Móviles',
  description = 'Empresa especializada en el alquiler de cuartos fríos, cámaras de congelación y conservación para alimentos, farmacéutica y flores.',
  activePage = 'inicio',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="alquiler cuartos frios, camaras frigorificas, cuartos congelacion, refrigeracion industrial, Otiemfri Refrigeracion, ClimaCold" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <!-- TopBar por encima del Header -->
    <TopBar />

    <!-- Navbar Sticky -->
    <Navbar activePage={activePage} />

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Botón flotante de WhatsApp en la esquina inferior derecha con CONTÁCTANOS -->
    <WhatsAppButton />

    <!-- Footer de 3 columnas con copyright a la derecha -->
    <Footer />
  </body>
</html>
