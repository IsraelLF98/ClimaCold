---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    title: 'Venta e Instalación de Cuartos Fríos Industriales',
    desc: 'Venta de cuartos fríos y cámaras frigoríficas con instalación llave en mano en tu planta. Nos adaptamos a los requerimientos de tu empresa.',
    features: ['Instalación llave en mano', 'Garantía extendida', 'Asesoría técnica especializada']
  },
  {
    icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
    title: 'Mantenimiento Preventivo y Correctivo 24/7',
    desc: 'Técnicos certificados realizan revisiones periódicas de gas refrigerante, compresores, ventiladores y sellos de puertas sin costo adicional.',
    features: ['Atención a emergencias 24h', 'Repuestos originales incluidos', 'Técnicos certificados']
  },
  {
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
    title: 'Monitoreo Telemático de Temperatura (IoT)',
    desc: 'Sistema de telemetría remota que registra la temperatura cada minuto, enviando alertas automáticas a WhatsApp o Email en caso de anomalías.',
    features: ['Registro de datos continuo', 'Informes auditables de calidad', 'Alertas de puerta abierta']
  },
  {
    icon: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
    title: 'Asesoría y Proyectos Frigoríficos',
    desc: 'Diseñamos proyectos de refrigeración personalizados para optimizar el consumo de energía y maximizar el espacio útil de almacenamiento.',
    features: ['Cálculo de carga térmica', 'Optimización energética', 'Cumplimiento de normas sanitarias']
  }
];
---

<Layout title="Servicios | ClimaCold - Venta y Refrigeración Industrial" activePage="servicios">
  <section class="page-header">
    <div class="container text-center">
      <span class="badge" style="color:#fff;">NUESTROS SERVICIOS</span>
      <h1 class="page-title">Soluciones Frigoríficas Integrales</h1>
      <p class="page-subtitle">
        Ofrecemos un servicio completo que va desde la venta e instalación hasta el mantenimiento y monitoreo continuo.
      </p>
    </div>
  </section>

  <section class="services-grid-section">
    <div class="container">
      <div class="services-grid">
        {services.map(service => (
          <div class="glass-card service-card">
            <div class="service-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={service.icon}></path>
              </svg>
            </div>
            <h3 class="service-card-title">{service.title}</h3>
            <p class="service-card-desc">{service.desc}</p>
            <ul class="service-features">
              {service.features.map(feat => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
            <a href="/contacto" class="btn-secondary service-btn">Solicitar Servicio</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 5rem 0 3rem 0;
    background: linear-gradient(135deg, #1E537F 0%, #286ea8 100%);
    border-bottom: 1px solid var(--border-light);
  }

  .text-center { text-align: center; }

  .page-title {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 800;
    color: #fff;
    margin: 0.5rem 0;
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: #dbeafe;
    max-width: 650px;
    margin: 0 auto;
  }

  .services-grid-section {
    padding: 5rem 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .service-icon-box {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    background: rgba(30, 83, 127, 0.1);
    border: 1px solid var(--border-cyan);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px var(--color-primary-glow);
  }

  .service-card-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #1E537F;
  }

  .service-card-desc {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.6;
    font-weight: 500;
  }

  .service-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
  }

  .service-features li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: #1e293b;
    font-weight: 600;
  }

  .service-features svg {
    color: #1E537F;
  }

  .service-btn {
    width: 100%;
    margin-top: 0.5rem;
  }
</style>
