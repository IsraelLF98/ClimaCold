---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto | ClimaCold - Alquiler de Cuartos Fríos" activePage="contacto">
  <section class="page-header">
    <div class="container text-center">
      <span class="badge">CONTACTO DIRECTO</span>
      <h1 class="page-title">Ponte en Contacto con Nosotros</h1>
      <p class="page-subtitle">
        Estamos listos para atender tus requerimientos de refrigeración y cotizaciones personalizadas.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <!-- Información de contacto -->
        <div class="glass-card contact-info-card">
          <h2 class="card-heading">Información de Atención</h2>
          <p class="info-lead">
            Contáctanos a través de cualquiera de nuestros canales habilitados 24/7.
          </p>

          <div class="info-list">
            <div class="info-item">
              <div class="info-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div class="info-text">
                <strong>Teléfono / WhatsApp:</strong>
                <a href="tel:+593991234567">+593 99 123 4567 / +51 987 654 321</a>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </div>
              <div class="info-text">
                <strong>Correo Electrónico:</strong>
                <a href="mailto:contacto@climacold.com">contacto@climacold.com</a>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div class="info-text">
                <strong>Dirección de Oficinas y Planta:</strong>
                <span>Av. Industrial Frigorífica #450, Parque Logístico del Norte</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Formulario -->
        <div class="glass-card contact-form-card">
          <h2 class="card-heading">Envíanos un Mensaje</h2>
          <form class="contact-form" id="contactForm">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Nombre Completo</label>
                <input type="text" id="name" required placeholder="Ej. Carlos Mendoza" class="form-input" />
              </div>
              <div class="form-group">
                <label for="company">Empresa</label>
                <input type="text" id="company" placeholder="Ej. Alimentos del Norte S.A." class="form-input" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">Correo Electrónico</label>
                <input type="email" id="email" required placeholder="carlos@empresa.com" class="form-input" />
              </div>
              <div class="form-group">
                <label for="phone">Teléfono / Celular</label>
                <input type="tel" id="phone" required placeholder="+593 99 999 9999" class="form-input" />
              </div>
            </div>

            <div class="form-group">
              <label for="service">Servicio de Interés</label>
              <select id="service" class="form-input">
                <option value="congelacion">Alquiler Cámara de Congelación (-18°C a -25°C)</option>
                <option value="conservacion">Alquiler Cámara de Conservación (0°C a +8°C)</option>
                <option value="movil">Unidad Móvil Frigorífica</option>
                <option value="mantenimiento">Servicio de Mantenimiento</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Detalles del Requerimiento</label>
              <textarea id="message" rows="4" required placeholder="Describa el producto a almacenar, tiempo estimado y volumen requerido..." class="form-input"></textarea>
            </div>

            <button type="submit" class="btn-primary form-submit-btn">
              Enviar Mensaje
            </button>
            <div id="formStatus" class="form-status"></div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 5rem 0 3rem 0;
    background: linear-gradient(135deg, #1E537F 0%, #286ea8 100%);
    border-bottom: 1px solid var(--border-light);
  }

  .text-center { text-align: center; }

  .page-title {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 800;
    color: #fff;
    margin: 0.5rem 0;
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: #dbeafe;
    max-width: 650px;
    margin: 0 auto;
  }

  .contact-section {
    padding: 5rem 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2.5rem;
  }

  .card-heading {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 1rem;
  }

  .info-lead {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .info-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .info-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(30, 83, 127, 0.1);
    border: 1px solid var(--border-cyan);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .info-text strong {
    color: var(--text-main);
  }

  .info-text a {
    color: var(--color-primary);
  }

  .info-text a:hover {
    color: #286ea8;
    text-decoration: underline;
  }

  /* Formulario */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .form-input {
    width: 100%;
    padding: 0.8rem 1rem;
    background: #ffffff;
    border: 1px solid var(--border-cyan);
    border-radius: var(--radius-md);
    color: var(--text-main);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: var(--transition);
  }

  .form-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 15px var(--color-primary-glow);
  }

  .form-submit-btn {
    width: 100%;
    margin-top: 0.5rem;
  }

  .form-status {
    font-size: 0.95rem;
    font-weight: 600;
    text-align: center;
    min-height: 24px;
  }

  @media (max-width: 868px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const status = document.getElementById('formStatus');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (status) {
        status.style.color = '#00d2ff';
        status.textContent = '¡Gracias por tu mensaje! Un asesor de ClimaCold te contactará en breve.';
        form.reset();
      }
    });
  }
</script>
