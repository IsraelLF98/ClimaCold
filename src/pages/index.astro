---
import Layout from "../layouts/Layout.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import QuoteCalculator from "../components/QuoteCalculator.astro";
import { Image } from "astro:assets";

const proyectos = Object.values(
  import.meta.glob("../assets/galeria/proyectos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}", { eager: true, import: "default" })
) as ImageMetadata[];
const mantenimiento = Object.values(
  import.meta.glob("../assets/galeria/mantenimiento/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}", { eager: true, import: "default" })
) as ImageMetadata[];
const transporte = Object.values(
  import.meta.glob("../assets/galeria/transporte/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}", { eager: true, import: "default" })
) as ImageMetadata[];

const imgProduct1 = proyectos[3] || proyectos[0];
const imgProduct2 = mantenimiento[0] || proyectos[4] || proyectos[1];
const imgProduct3 = transporte[0] || proyectos[5] || proyectos[2];

const galeria = [...proyectos.slice(0, 8), ...mantenimiento.slice(0, 4), ...transporte.slice(0, 4)].filter(Boolean);

const videos = [
  "/videos/proyectos/2026-01-05-094005573%20(1).mp4",
  "/videos/proyectos/VID_20251223_102917.mp4",
  "/videos/proyectos/VID_20251223_163628.mp4",
  "/videos/proyectos/VID_20260326_163844757.mp4",
  "/videos/proyectos/VID_20261007_160941724.mp4",
];
---

<Layout
  title="ClimaCold | Venta de Cuartos Fríos y Refrigeración Industrial"
  activePage="inicio"
>
  <HeroCarousel />

  <section class="stats-section">
    <div class="container stats-grid">
      <div class="stat-item">
        <div class="stat-number text-gradient">+250</div>
        <div class="stat-label">Cuartos fríos vendidos e instalados</div>
      </div>
      <div class="stat-item">
        <div class="stat-number text-gradient">-25°C</div>
        <div class="stat-label">Capacidad de congelación</div>
      </div>
      <div class="stat-item">
        <div class="stat-number text-gradient">24/7</div>
        <div class="stat-label">Monitoreo telemático y soporte</div>
      </div>
      <div class="stat-item">
        <div class="stat-number text-gradient">100%</div>
        <div class="stat-label">Garantía en cadena de frío</div>
      </div>
    </div>
  </section>

  <section class="products-preview-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge">NUESTROS PRODUCTOS</span>
        <h2 class="section-title">Soluciones de refrigeración a tu medida</h2>
        <p class="section-subtitle">
          Vendemos equipamiento frigorífico de última generación con instalación, garantía y mantenimiento preventivo incluidos.
        </p>
      </div>

      <div class="products-grid">
        <div class="glass-card product-card">
          <div class="card-img-wrapper">
            <Image src={imgProduct1} alt="Cámaras de congelación industrial" class="card-img" format="webp" quality={80} sizes="(min-width: 1024px) 400px, 100vw" />
            <span class="card-tag">Congelación rápida</span>
          </div>
          <div class="card-content">
            <h3>Cámaras de congelación (-18°C a -25°C)</h3>
            <p>Ideales para conservación de carnes, mariscos, helados y productos biológicos que exigen temperaturas bajo cero continuas.</p>
            <div class="card-specs">
              <span><strong>Aislamiento:</strong> Poliuretano 120 mm</span>
              <span><strong>Control:</strong> Digital IoT</span>
            </div>
            <a href="/productos" class="btn-secondary card-btn">Saber más</a>
          </div>
        </div>

        <div class="glass-card product-card">
          <div class="card-img-wrapper">
            <Image src={imgProduct2} alt="Cuartos fríos modulares" class="card-img" format="webp" quality={80} sizes="(min-width: 1024px) 400px, 100vw" />
            <span class="card-tag">Conservación</span>
          </div>
          <div class="card-content">
            <h3>Cuartos fríos modulares (0°C a +8°C)</h3>
            <p>Diseñados para frutas, verduras, lácteos y flores. Ensamblaje rápido en instalaciones del cliente con paneles desmontables.</p>
            <div class="card-specs">
              <span><strong>Aislamiento:</strong> Poliuretano 80 mm</span>
              <span><strong>Luz:</strong> LED antihumedad</span>
            </div>
            <a href="/productos" class="btn-secondary card-btn">Saber más</a>
          </div>
        </div>

        <div class="glass-card product-card">
          <div class="card-img-wrapper">
            <Image src={imgProduct3} alt="Unidades móviles refrigeradas" class="card-img" format="webp" quality={80} sizes="(min-width: 1024px) 400px, 100vw" />
            <span class="card-tag">Portátil / Móvil</span>
          </div>
          <div class="card-content">
            <h3>Unidades frigoríficas móviles</h3>
            <p>Contenedores y remolques equipados con sistemas frigoríficos autónomos para eventos, emergencias y transporte logístico.</p>
            <div class="card-specs">
              <span><strong>Conexión:</strong> Trifásica / Generador diésel</span>
              <span><strong>Movilidad:</strong> Remolque listo</span>
            </div>
            <a href="/productos" class="btn-secondary card-btn">Saber más</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <QuoteCalculator />

  <section class="features-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge">¿POR QUÉ ELEGIR CLIMACOLD?</span>
        <h2 class="section-title">Respaldo técnico garantizado</h2>
      </div>

      <div class="features-grid">
        <div class="glass-card feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <h3>Monitoreo 24/7 en tiempo real</h3>
          <p>Sensores telemáticos que envían alertas a tu celular en caso de fluctuación de temperatura o aperturas prolongadas.</p>
        </div>

        <div class="glass-card feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <h3>Eficiencia energética A+</h3>
          <p>Compresores ecoamigables inverter de bajo consumo eléctrico que reducen tus costos operativos de energía.</p>
        </div>

        <div class="glass-card feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
          </div>
          <h3>Mantenimiento preventivo</h3>
          <p>Equipo técnico especializado realiza inspecciones periódicas y reemplazo preventivo de componentes para garantizar continuidad.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="gallery-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge">GALERÍA</span>
        <h2 class="section-title">Proyectos, mantenimiento y transporte</h2>
        <p class="section-subtitle">Algunos de nuestros trabajos y equipos en campo.</p>
      </div>
      <div class="gallery-grid">
        {galeria.map((img, i) => (
          <div class="gallery-item glass-card">
            <Image src={img} alt={`Trabajo ClimaCold ${i + 1}`} class="gallery-img" loading="lazy" format="webp" quality={75} widths={[320, 640]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
          </div>
        ))}
      </div>

      <div class="videos-block">
        <h3 class="videos-title">Videos de nuestros proyectos</h3>
        <div class="videos-grid">
          {videos.map((src, i) => (
            <div class="video-item glass-card">
              <video controls preload="metadata" playsinline class="project-video">
                <source src={src} type="video/mp4" />
                Tu navegador no soporta la reproducción de video.
              </video>
              <p class="video-caption">Proyecto en ejecución {i + 1}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cta-banner-section">
    <div class="container">
      <div class="cta-box glass-card">
        <div class="cta-content">
          <h2 class="cta-title">¿Necesitas un cuarto frío de urgencia?</h2>
          <p class="cta-desc">
            Instalamos y entregamos tu solución frigorífica en menos de 24 horas. Asesoría técnica sin compromiso.
          </p>
        </div>
        <div class="cta-actions">
          <a href="/contacto" class="btn-primary btn-large">
            Solicitar asesoría inmediata
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .stats-section {
    padding: 3.5rem 0;
    background: #ffffff;
    border-bottom: 1px solid var(--border-light);
    box-shadow: 0 4px 15px rgba(30, 83, 127, 0.05);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    text-align: center;
  }

  .stat-number {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .products-preview-section {
    padding: 6rem 0;
  }

  .text-center {
    text-align: center;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--text-main);
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 620px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .card-img-wrapper {
    position: relative;
    height: 230px;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .card-img {
    transform: scale(1.08);
  }

  .card-tag {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #1e537f;
    border: 1px solid var(--border-cyan);
    color: #ffffff;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .card-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-grow: 1;
  }

  .card-content h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .card-content p {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .card-specs {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: #1e537f;
    background: rgba(30, 83, 127, 0.05);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px dashed var(--border-cyan);
  }

  .card-btn {
    margin-top: auto;
    width: 100%;
  }

  .features-section {
    padding: 5rem 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(136, 179, 211, 0.15) 100%
    );
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .feature-icon {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    background: rgba(30, 83, 127, 0.1);
    border: 1px solid var(--border-cyan);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px var(--color-primary-glow);
  }

  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .feature-card p {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .gallery-section {
    padding: 5rem 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .gallery-item {
    padding: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.06);
  }

  .videos-block {
    margin-top: 3.5rem;
  }

  .videos-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-main);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .video-item {
    padding: 0.75rem;
    overflow: hidden;
  }

  .project-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    background: #000;
    display: block;
  }

  .video-caption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-align: center;
    font-weight: 600;
  }

  .cta-banner-section {
    padding: 4rem 0 6rem 0;
  }

  .cta-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    background: linear-gradient(135deg, #1e537f 0%, #296fa9 100%);
    border: 1px solid #1e537f;
    padding: 3rem;
    color: #ffffff;
  }

  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .cta-desc {
    font-size: 1.1rem;
    color: #dbeafe;
    max-width: 600px;
  }

  .btn-large {
    padding: 1rem 2.2rem;
    font-size: 1.1rem;
    white-space: nowrap;
    background: #ffffff;
    color: #1e537f;
  }

  .btn-large:hover {
    background: #88b3d3;
    color: #ffffff;
  }

  @media (max-width: 868px) {
    .cta-box {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
