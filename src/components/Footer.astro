---
import { Image } from 'astro:assets';
import logoImg from '../assets/LOGO 2.png';

const navLinks = [
  { label: 'INICIO', href: '/' },
  { label: 'PRODUCTOS', href: '/productos' },
  { label: 'SERVICIOS', href: '/servicios' },
  { label: '¿QUIÉNES SOMOS?', href: '/quienes-somos' },
  { label: 'CONTACTO', href: '/contacto' },
];
---

<footer class="site-footer">
  <div class="container footer-content">
    <!-- Lado Izquierdo: Logo de la empresa -->
    <div class="footer-left">
      <a href="/" class="footer-logo-link" aria-label="Inicio ClimaCold">
        <Image src={logoImg} alt="ClimaCold Refrigeración" class="footer-logo-img" />
      </a>
      <p class="footer-brand-desc">
        Soluciones integrales de refrigeración industrial y venta de cuartos fríos de alta eficiencia energética.
      </p>
    </div>

    <!-- En el Medio: Texto ClimaCold y debajo los links a cada sección -->
    <div class="footer-middle">
      <h3 class="footer-title" style="color:#fff;">ClimaCold</h3>
      <nav class="footer-nav">
        {navLinks.map(link => (
          <a href={link.href} class="footer-link">{link.label}</a>
        ))}
      </nav>
    </div>

    <!-- Lado Derecho: Encuéntranos, dirección, mail, celular y redes sociales -->
    <div class="footer-right">
      <h3 class="footer-title">Encuéntranos</h3>
      <div class="contact-info">
        <p><strong>Dirección:</strong> Av. Industrial Frigorífica #450, Parque Logístico del Norte</p>
        <p><strong>Mail:</strong> <a href="mailto:contacto@climacold.com">contacto@climacold.com</a></p>
        <p><strong>Celular:</strong> <a href="tel:+593991234567">+593 99 123 4567</a></p>
      </div>

      <!-- Redes Sociales -->
      <div class="social-links">
        <a href="#" aria-label="Facebook" class="social-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="#" aria-label="Instagram" class="social-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
        </a>
        <a href="#" aria-label="LinkedIn" class="social-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href="#" aria-label="WhatsApp" class="social-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Parte Inferior: Copyright a la derecha (o centrado en celulares) -->
  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <div class="copyright-right">
        © 2026 ClimaCold Refrigeración. Todos los derechos reservados.
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-footer);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
    padding-top: 4rem;
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }

  /* Footer Izquierda */
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    transition: var(--transition);
    padding: 0;
  }

  .footer-logo-link:hover {
    transform: scale(1.04);
  }

  .footer-logo-img {
    height: 95px;
    width: auto;
    max-width: 360px;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.45)) drop-shadow(0 4px 14px rgba(0, 0, 0, 0.5));
    transition: var(--transition);
    transform-origin: left center;
    animation: footerLogoFadeIn 0.7s ease-out 1s both;
  }

  .footer-logo-img:hover {
    filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.8)) drop-shadow(0 6px 18px rgba(136, 179, 211, 0.6));
  }

  @keyframes footerLogoFadeIn {
    0% {
      opacity: 0;
      transform: scale(0.9);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .footer-brand-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #dbeafe;
    max-width: 320px;
  }

  /* Footer Medio */
  .footer-middle {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .footer-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.5px;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    font-size: 0.95rem;
    color: #e2e8f0;
    font-weight: 500;
    transition: var(--transition);
  }

  .footer-link:hover {
    color: #88B3D3;
    transform: translateX(4px);
  }

  /* Footer Derecha */
  .footer-right {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .contact-info {
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: #e2e8f0;
  }

  .contact-info strong {
    color: #ffffff;
  }

  .contact-info a {
    color: #88B3D3;
  }

  .contact-info a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .social-links {
    display: flex;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transition: var(--transition);
  }

  .social-icon:hover {
    background: #88B3D3;
    color: #1E537F;
    border-color: #88B3D3;
    transform: translateY(-3px);
    box-shadow: 0 4px 15px rgba(136, 179, 211, 0.4);
  }

  /* Footer Bottom */
  .footer-bottom {
    background-color: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.25rem 0;
  }

  .footer-bottom-container {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .copyright-right {
    font-size: 0.85rem;
    color: #dbeafe;
    font-weight: 500;
    text-align: right;
  }

  /* Responsive iPad / Tablet (768px - 1024px) */
  @media (max-width: 1024px) {
    .footer-content {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
    }
  }

  /* Responsive Celulares (< 768px) */
  @media (max-width: 768px) {
    .site-footer {
      padding-top: 3rem;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      text-align: center;
    }

    .footer-left {
      align-items: center;
    }

    .footer-logo-link {
      align-items: center;
    }

    .footer-brand-desc {
      text-align: center;
    }

    .footer-link:hover {
      transform: none;
    }

    .social-links {
      justify-content: center;
    }

    .footer-bottom-container {
      justify-content: center;
    }

    .copyright-right {
      text-align: center;
      font-size: 0.8rem;
    }
  }
</style>
