---
import { Image } from 'astro:assets';

const proyectos = Object.values(
  import.meta.glob('../assets/galeria/proyectos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true, import: 'default' })
) as ImageMetadata[];
const transporte = Object.values(
  import.meta.glob('../assets/galeria/transporte/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true, import: 'default' })
) as ImageMetadata[];

const heroImages = [
  proyectos[0] || transporte[0],
  proyectos[1] || proyectos[0] || transporte[1],
  transporte[0] || proyectos[2] || proyectos[0],
].filter(Boolean);

const slides = [
  {
    image: heroImages[0],
    badge: 'TECNOLOGÍA DE VANGUARDIA',
    title: 'Venta de Cuartos Fríos Industriales',
    description: 'Control de temperatura de alta precisión (-25°C a +8°C) para la industria alimentaria, farmacéutica y florícola.',
    ctaPrimary: 'Ver productos',
    ctaPrimaryLink: '/productos',
    ctaSecondary: 'Cotizar precio',
    ctaSecondaryLink: '/contacto'
  },
  {
    image: heroImages[1],
    badge: 'FLEXIBILIDAD Y MODULARIDAD',
    title: 'Cámaras Frías Modulares a Medida',
    description: 'Instalación rápida en cualquier espacio con aislamiento térmico de alta densidad y monitoreo telemático 24/7.',
    ctaPrimary: 'Nuestros servicios',
    ctaPrimaryLink: '/servicios',
    ctaSecondary: 'Contactar asesor',
    ctaSecondaryLink: '/contacto'
  },
  {
    image: heroImages[2],
    badge: 'LOGÍSTICA MÓVIL REFRIGERADA',
    title: 'Unidades Móviles de Congelación',
    description: 'Soluciones portátiles sobre contenedores y remolques listos para conectar y mantener tu cadena de frío en movimiento.',
    ctaPrimary: 'Conocer unidades',
    ctaPrimaryLink: '/productos',
    ctaSecondary: 'Contáctanos',
    ctaSecondaryLink: '/contacto'
  }
];
---

<section class="hero-carousel-section">
  <div class="carousel-container" id="heroCarousel">
    {slides.map((slide, index) => (
      <div class={`carousel-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
        <div class="slide-bg-overlay"></div>
        <Image src={slide.image} alt={slide.title} class="slide-img" loading={index === 0 ? "eager" : "lazy"} format="webp" quality={80} sizes="100vw" fetchpriority={index === 0 ? "high" : "auto"} />
        <div class="container slide-content-wrapper">
          <div class="slide-content">
            <span class="badge slide-badge">{slide.badge}</span>
            <h1 class="slide-title">{slide.title}</h1>
            <p class="slide-desc">{slide.description}</p>
            <div class="slide-actions">
              <a href={slide.ctaPrimaryLink} class="btn-primary">
                {slide.ctaPrimary}
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
              <a href={slide.ctaSecondaryLink} class="btn-secondary">
                {slide.ctaSecondary}
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}

    <button class="carousel-control prev" id="carouselPrev" aria-label="Diapositiva anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="carousel-control next" id="carouselNext" aria-label="Diapositiva siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

    <div class="carousel-indicators" id="carouselIndicators">
      {slides.map((_, index) => (
        <button class={`indicator-dot ${index === 0 ? 'active' : ''}`} data-slide={index} aria-label={`Ir a diapositiva ${index + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-carousel-section {
    position: relative;
    width: 100%;
    height: 82vh;
    min-height: 540px;
    max-height: 750px;
    overflow: hidden;
    background: #050914;
  }

  .carousel-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
    display: flex;
    align-items: center;
  }

  .carousel-slide.active {
    opacity: 1;
    visibility: visible;
  }

  .slide-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
    transform: scale(1.05);
    transition: transform 6s ease;
  }

  .carousel-slide.active .slide-img {
    transform: scale(1);
  }

  .slide-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba(7, 13, 30, 0.94) 0%,
      rgba(11, 19, 43, 0.78) 55%,
      rgba(7, 13, 30, 0.45) 100%
    );
    z-index: 2;
  }

  .slide-content-wrapper {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .slide-content {
    max-width: 650px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    animation: fadeInUp 0.8s ease forwards;
  }

  .slide-badge {
    background: rgba(136, 179, 211, 0.25);
    border: 1px solid #88B3D3;
    color: #ffffff;
    font-weight: 800;
    width: fit-content;
  }

  .slide-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: #ffffff;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  }

  .slide-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: #ffffff;
    line-height: 1.6;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .slide-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .carousel-control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #1E537F;
    border: 1.5px solid #88B3D3;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
    transition: var(--transition);
    cursor: pointer;
  }

  .carousel-control:hover {
    background: #88B3D3;
    color: #1E537F;
    box-shadow: 0 0 20px rgba(136, 179, 211, 0.5);
  }

  .carousel-control.prev { left: 1.5rem; }
  .carousel-control.next { right: 1.5rem; }

  .carousel-indicators {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    gap: 0.75rem;
  }

  .indicator-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    border: none;
    transition: var(--transition);
    cursor: pointer;
  }

  .indicator-dot.active {
    width: 36px;
    border-radius: 10px;
    background: #88B3D3;
    box-shadow: 0 0 12px rgba(136, 179, 211, 0.5);
  }

  @media (max-width: 1024px) {
    .hero-carousel-section { height: 65vh; min-height: 480px; }
    .slide-content { max-width: 550px; }
    .carousel-control.prev { left: 1rem; }
    .carousel-control.next { right: 1rem; }
  }

  @media (max-width: 768px) {
    .hero-carousel-section { height: 75vh; min-height: 440px; }
    .slide-bg-overlay {
      background: linear-gradient(180deg, rgba(7, 13, 30, 0.92) 0%, rgba(11, 19, 43, 0.85) 60%, rgba(7, 13, 30, 0.95) 100%);
    }
    .slide-content { max-width: 100%; text-align: center; align-items: center; padding: 0 0.5rem; }
    .slide-actions { justify-content: center; width: 100%; }
    .slide-actions .btn-primary, .slide-actions .btn-secondary { width: 100%; }
    .carousel-control { width: 40px; height: 40px; top: auto; bottom: 1.5rem; transform: none; }
    .carousel-control.prev { left: 1rem; }
    .carousel-control.next { right: 1rem; }
    .carousel-indicators { bottom: 2rem; }
  }
</style>

<script>
  const slides = document.querySelectorAll('.carousel-slide');
  const dots = document.querySelectorAll('.indicator-dot');
  const prevBtn = document.getElementById('carouselPrev');
  const nextBtn = document.getElementById('carouselNext');

  let currentIndex = 0;
  let timer: number | undefined;

  function showSlide(index: number) {
    slides.forEach((slide, i) => { slide.classList.toggle('active', i === index); });
    dots.forEach((dot, i) => { dot.classList.toggle('active', i === index); });
    currentIndex = index;
  }

  function nextSlide() { showSlide((currentIndex + 1) % slides.length); }
  function prevSlide() { showSlide((currentIndex - 1 + slides.length) % slides.length); }
  function startAutoplay() { stopAutoplay(); timer = window.setInterval(nextSlide, 5000); }
  function stopAutoplay() { if (timer) clearInterval(timer); }

  if (nextBtn && prevBtn) {
    nextBtn.addEventListener('click', () => { nextSlide(); startAutoplay(); });
    prevBtn.addEventListener('click', () => { prevSlide(); startAutoplay(); });
    dots.forEach((dot, i) => { dot.addEventListener('click', () => { showSlide(i); startAutoplay(); }); });
    startAutoplay();
  }
</script>
