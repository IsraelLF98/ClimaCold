---
import { Image } from 'astro:assets';
import logoImg from '../assets/LOGO.jpeg';

interface Props {
  activePage?: 'inicio' | 'productos' | 'servicios' | 'quienes-somos' | 'contacto';
}

const { activePage = 'inicio' } = Astro.props;

const navItems = [
  { label: 'INICIO', href: '/' },
  { label: 'PRODUCTOS', href: '/productos' },
  { label: 'SERVICIOS', href: '/servicios' },
  { label: '¿QUIÉNES SOMOS?', href: '/quienes-somos' },
  { label: 'CONTACTO', href: '/contacto' },
];
---

<header class="navbar-header">
  <div class="container navbar-container">
    <!-- Logo a la izquierda -->
    <a href="/" class="brand-logo" aria-label="ClimaCold Inicio">
      <Image src={logoImg} alt="ClimaCold Otiemfri Refrigeración Logo" class="logo-img" />
    </a>

    <!-- Navegación escritorio y tablets grandes -->
    <nav class="nav-links">
      {navItems.map((item) => {
        const key = item.href === '/' ? 'inicio' : item.href.replace('/', '');
        const isActive = activePage === key;
        return (
          <a
            href={item.href}
            class={`nav-link ${isActive ? 'active' : ''}`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Botón Menú Móvil / iPad portrait -->
    <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Abrir menú de navegación">
      <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Menú desplegable para Celulares e iPads en vertical -->
  <div class="mobile-menu" id="mobileMenu">
    {navItems.map((item) => {
      const key = item.href === '/' ? 'inicio' : item.href.replace('/', '');
      const isActive = activePage === key;
      return (
        <a href={item.href} class={`mobile-nav-link ${isActive ? 'active' : ''}`}>
          {item.label}
        </a>
      );
    })}
  </div>
</header>

<style>
  .navbar-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--bg-nav);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 25px rgba(30, 83, 127, 0.25);
  }

  .navbar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 75px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
  }

  .logo-img {
    height: 52px;
    width: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
    transition: var(--transition);
    filter: drop-shadow(0 2px 8px rgba(255, 255, 255, 0.2));
  }

  .logo-img:hover {
    transform: scale(1.03);
    filter: drop-shadow(0 4px 14px rgba(255, 255, 255, 0.4));
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    font-weight: 600;
    font-size: 0.92rem;
    color: #ffffff;
    letter-spacing: 0.5px;
    position: relative;
    padding: 0.5rem 0;
    white-space: nowrap;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: #88B3D3;
    transition: var(--transition);
    border-radius: 2px;
  }

  .nav-link:hover {
    color: #88B3D3;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-link.active {
    color: #ffffff;
    font-weight: 700;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    color: #ffffff;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    transition: var(--transition);
  }

  .mobile-toggle:hover {
    color: #88B3D3;
    background: rgba(255, 255, 255, 0.1);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    background: var(--bg-nav);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding: 1.25rem 1.5rem;
    gap: 0.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .mobile-nav-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-nav-link.active {
    color: #88B3D3;
    font-weight: 700;
  }

  /* iPad / Tablets */
  @media (max-width: 1024px) {
    .nav-links {
      gap: 1.2rem;
    }
    .nav-link {
      font-size: 0.85rem;
    }
  }

  /* Mobile / Tablets medianas y pequeñas (< 900px) */
  @media (max-width: 900px) {
    .navbar-container {
      height: 65px;
    }
    .logo-img {
      height: 44px;
    }
    .nav-links {
      display: none;
    }
    .mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mobile-menu.open {
      display: flex;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('open');
    });

    // Cerrar al presionar en enlaces
    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('open');
      });
    });
  }
</script>
