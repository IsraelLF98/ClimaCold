  </div>
  <span class="label-text">CONTÁCTANOS</span>
</a>

<style>
  .whatsapp-float-btn {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, #25d366, #128c7e);
    color: #ffffff;
    padding: 0.75rem;
    border-radius: 50px;
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.45);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    text-decoration: none;
    overflow: hidden;
    max-width: 54px;
    cursor: pointer;
    touch-action: manipulation;
  }

  .icon-wrapper { display: flex; align-items: center; justify-content: center; min-width: 30px; height: 30px; }

  .label-text {
    font-weight: 800;
    font-size: 0.88rem;
    letter-spacing: 0.8px;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(10px);
    transition: all 0.35s ease;
    padding-right: 0.75rem;
    padding-left: 0.25rem;
  }

  .whatsapp-float-btn::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: 50px;
    border: 2px solid #25d366;
    animation: pulseBorder 2s infinite;
    z-index: -1;
  }

  @keyframes pulseBorder {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  .whatsapp-float-btn:hover, .whatsapp-float-btn.expanded {
    max-width: 210px;
    padding-right: 1.1rem;
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.6);
    transform: translateY(-3px);
  }

  .whatsapp-float-btn:hover .label-text, .whatsapp-float-btn.expanded .label-text {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .whatsapp-float-btn { bottom: 18px; right: 18px; padding: 0.65rem; max-width: 48px; }
    .icon-wrapper { min-width: 26px; height: 26px; }
    .whatsapp-float-btn:hover, .whatsapp-float-btn.expanded { max-width: 190px; }
  }
</style>

<script>
  const btn = document.getElementById('whatsappFloat');
  let scrollTimeout: number | undefined;

  window.addEventListener('scroll', () => {
    if (btn) {
      btn.classList.add('expanded');
      if (scrollTimeout) clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(() => {
        if (!btn.matches(':hover')) btn.classList.remove('expanded');
      }, 2500);
    }
  });
</script>
